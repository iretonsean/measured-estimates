{
  "description": "measured-estimates: records each session's token use on this machine (see docs/DATA.md).",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" session-end", "timeout": 5}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" stop", "timeout": 30, "async": true}
        ]
      }
    ]
  }
}
