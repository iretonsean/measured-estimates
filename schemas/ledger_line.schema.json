{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "ledger line (one session)",
 "type": "object",
 "required": [
  "schema_version",
  "session_id",
  "agent",
  "adapter_version",
  "machine",
  "reason",
  "recorded_at",
  "first",
  "last",
  "messages",
  "duplicate_messages",
  "subagents",
  "skipped_lines",
  "fresh_tokens",
  "cache_read_tokens",
  "by_model_effort",
  "tasks",
  "untied",
  "tagged",
  "commits"
 ],
 "additionalProperties": false,
 "properties": {
  "schema_version": {
   "const": 1
  },
  "session_id": {
   "type": "string",
   "pattern": "[A-Za-z0-9_-]{1,80}"
  },
  "agent": {
   "type": "string",
   "pattern": "[a-z0-9-]{1,32}"
  },
  "adapter_version": {
   "type": "string",
   "pattern": "[0-9.]{1,16}"
  },
  "machine": {
   "type": "string",
   "pattern": "[0-9a-f]{16}"
  },
  "reason": {
   "enum": [
    "session_end",
    "stop",
    "backfill",
    "manual"
   ]
  },
  "recorded_at": {
   "type": "string",
   "pattern": "\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ"
  },
  "first": {
   "type": "string",
   "pattern": "\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ"
  },
  "last": {
   "type": "string",
   "pattern": "\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ"
  },
  "messages": {
   "type": "integer",
   "minimum": 0
  },
  "duplicate_messages": {
   "type": "integer",
   "minimum": 0
  },
  "subagents": {
   "type": "integer",
   "minimum": 0
  },
  "skipped_lines": {
   "type": "integer",
   "minimum": 0
  },
  "fresh_tokens": {
   "type": "integer",
   "minimum": 0
  },
  "cache_read_tokens": {
   "type": "integer",
   "minimum": 0
  },
  "by_model_effort": {
   "type": "object",
   "patternProperties": {
    "[A-Za-z0-9._:/@-]{1,64}": {
     "type": "object",
     "patternProperties": {
      "[a-z0-9-]{1,16}": {
       "type": "object",
       "required": [
        "fresh",
        "cache_reads",
        "messages"
       ],
       "additionalProperties": false,
       "properties": {
        "fresh": {
         "type": "integer",
         "minimum": 0
        },
        "cache_reads": {
         "type": "integer",
         "minimum": 0
        },
        "messages": {
         "type": "integer",
         "minimum": 0
        }
       }
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "tasks": {
   "type": "object",
   "patternProperties": {
    "[A-Za-z0-9#._:-]{1,64}": {
     "type": "object",
     "required": [
      "fresh",
      "by_role",
      "by_model_effort",
      "active_s",
      "start",
      "end"
     ],
     "additionalProperties": false,
     "properties": {
      "fresh": {
       "type": "integer",
       "minimum": 0
      },
      "by_role": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "build": {
         "type": "integer",
         "minimum": 0
        },
        "review": {
         "type": "integer",
         "minimum": 0
        },
        "fix": {
         "type": "integer",
         "minimum": 0
        },
        "lead": {
         "type": "integer",
         "minimum": 0
        }
       }
      },
      "by_model_effort": {
       "type": "object",
       "patternProperties": {
        "[A-Za-z0-9._:/@-]{1,64}": {
         "type": "object",
         "patternProperties": {
          "[a-z0-9-]{1,16}": {
           "type": "integer",
           "minimum": 0
          }
         },
         "additionalProperties": false
        }
       },
       "additionalProperties": false
      },
      "active_s": {
       "type": "integer",
       "minimum": 0
      },
      "start": {
       "type": [
        "string",
        "null"
       ],
       "pattern": "\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ"
      },
      "end": {
       "type": [
        "string",
        "null"
       ],
       "pattern": "\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ"
      }
     }
    }
   },
   "additionalProperties": false
  },
  "untied": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "_other": {
     "type": "integer",
     "minimum": 0
    },
    "_after": {
     "type": "integer",
     "minimum": 0
    },
    "_untagged": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "tagged": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "required": [
      "ids",
      "role"
     ],
     "additionalProperties": false,
     "properties": {
      "ids": {
       "type": "array",
       "items": {
        "type": "string",
        "pattern": "[A-Za-z0-9#._:-]{1,64}"
       }
      },
      "role": {
       "enum": [
        "build",
        "review",
        "fix",
        "lead"
       ]
      },
      "from": {
       "type": "string",
       "pattern": "\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ"
      }
     }
    }
   ]
  },
  "commits": {
   "type": "integer",
   "minimum": 0
  },
  "cwd": {
   "type": "string",
   "maxLength": 300
  },
  "branch": {
   "type": "string",
   "maxLength": 100
  },
  "repo": {
   "type": "string",
   "maxLength": 100
  },
  "title": {
   "type": "string",
   "maxLength": 80
  }
 }
}
