{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "starter table (aggregates only)",
 "type": "object",
 "required": [
  "schema_version",
  "origin",
  "units",
  "sizes"
 ],
 "additionalProperties": false,
 "properties": {
  "schema_version": {
   "const": 1
  },
  "origin": {
   "type": "string",
   "maxLength": 300
  },
  "units": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "maxLength": 120
   }
  },
  "attribution": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "items_share": {
     "type": "number",
     "minimum": 0
    },
    "overhead": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "sizes": {
   "type": "object",
   "patternProperties": {
    "[A-Z]{1,4}(-[A-Z]{1,4})?": {
     "type": "object",
     "required": [
      "n",
      "range50",
      "median"
     ],
     "additionalProperties": false,
     "properties": {
      "n": {
       "type": "integer",
       "minimum": 5
      },
      "range50": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "tokens": {
         "type": "array",
         "items": {
          "type": "number",
          "minimum": 0
         }
        },
        "active_h": {
         "type": "array",
         "items": {
          "type": "number",
          "minimum": 0
         }
        },
        "elapsed_h": {
         "type": "array",
         "items": {
          "type": "number",
          "minimum": 0
         }
        }
       }
      },
      "range80": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "tokens": {
         "type": "array",
         "items": {
          "type": "number",
          "minimum": 0
         }
        }
       }
      },
      "median": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "tokens": {
         "type": "number",
         "minimum": 0
        },
        "active_h": {
         "type": "number",
         "minimum": 0
        },
        "elapsed_h": {
         "type": "number",
         "minimum": 0
        }
       }
      },
      "narrow50": {
       "type": "boolean"
      },
      "narrow80": {
       "type": "boolean"
      }
     }
    }
   },
   "additionalProperties": false
  }
 }
}
